<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel1="clr-namespace:NodeSharp.Nodes.KS0212.ViewModel"
             x:Class="NodeSharp.Nodes.KS0212.Component.NodeBodyComponent"
             x:DataType="viewModel1:NodeBodyViewModel"
             MinimumHeightRequest="120">

    <ContentView.Resources>
        <Style x:Key="IconButtonWithOpacityStyle" TargetType="Label">
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Node.HasOutputMessage}" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentView.Resources>

    <Grid
        Margin="4"
        Padding="8"
        VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
            Margin="0,0,8,0"
            Grid.Column="0"
            Grid.Row="0"
            Text="{Binding Node.TypeInformation.PresentationInformation.Symbol}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontFamily="{Binding Node.TypeInformation.PresentationInformation.FontFamilyName}"
            FontSize="18"
            TextColor="Black">
            <Label.GestureRecognizers>
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="PointerGestureRecognizer_OnPointerPressed" />
            </Label.GestureRecognizers>
        </Label>

        <Label
            Grid.Column="1"
            Grid.Row="0"
            Text="{Binding Node.Name}"
            LineBreakMode="NoWrap"
            HorizontalOptions="Center"
            FontAttributes="None" TextColor="DarkRed" FontSize="12">
        </Label>

        <Label Grid.Column="1"
               Grid.Row="1"
               Text="{Binding Node.TypeId}"
               LineBreakMode="NoWrap"
               HorizontalOptions="Center"
               FontAttributes="None" TextColor="DarkGreen" FontSize="14">
        </Label>

        <Grid Grid.Row="2" Grid.Column="0" VerticalOptions="Fill" HorizontalOptions="Fill"/>
        
        <Label
            Margin="0,0,4,0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="3"
            Style="{StaticResource IconButtonWithOpacityStyle}"
            Text="&#xf086;"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            FontFamily="FontSolid"
            FontSize="18"
            TextColor="DeepSkyBlue"
            ToolTipProperties.Text="Double-tap to view sent Json message"
            >
            <Label.GestureRecognizers>
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="PointerGestureRecognizer_OnPointerPressed" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>

</ContentView>