<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:NodeSharp.Client.Component"
             xmlns:toolkit="clr-namespace:Syncfusion.Maui.Toolkit;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="NodeSharp.Client.MainPage">


    <Grid x:Name="Viewport"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <component:NodeToolListComponent
            Grid.Column="0" Grid.Row="0"
            Title="Hello MAUI Component!" />

        <component:DiagramViewComponent Grid.Column="1" IsClippedToBounds="True"> </component:DiagramViewComponent>
        
        <component:DebugComponent Grid.Column="2" BackgroundColor="Bisque"></component:DebugComponent>
    </Grid>

</ContentPage>