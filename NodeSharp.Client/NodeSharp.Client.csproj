<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>NodeSharp.Client</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>NodeSharp</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.nodesharp.client</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
        <PackageReference Include="Facet" Version="5.4.3" />
        <PackageReference Include="Facet.Extensions" Version="5.4.3" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
        <PackageReference Include="Refit.HttpClientFactory" Version="9.0.2" />
        <PackageReference Include="Syncfusion.Maui.Backdrop" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Buttons" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Core" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.DataGrid" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Expander" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Gauges" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Inputs" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.ListView" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.NavigationDrawer" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Popup" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Sliders" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.TabView" Version="32.1.24" />
        <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.8" />
        <PackageReference Include="CommunityToolkit.Maui.Markup" Version="7.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
        <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.2.0" />
        <PackageReference Include="Syncfusion.Maui.TreeView" Version="32.1.24" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NodeSharp.NodeEngine\NodeSharp.NodeEngine.csproj" />
        <ProjectReference Include="..\NodeSharp.Nodes.Common\NodeSharp.Nodes.Common.csproj" />
        <ProjectReference Include="..\NodeSharp.Nodes.KS0212\NodeSharp.Nodes.KS0212.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Syncfusion.Maui.Core">
            <HintPath>C:\Users\jompa\.nuget\packages\syncfusion.maui.core\32.1.20\lib\net10.0-android36.0\Syncfusion.Maui.Core.dll</HintPath>
        </Reference>
        <Reference Include="Syncfusion.Maui.ListView">
            <HintPath>C:\Users\jompa\.nuget\packages\syncfusion.maui.listview\32.1.21\lib\net10.0-ios26.0\Syncfusion.Maui.ListView.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Nodes.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Update="Component\BoxAnchorRightComponent.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Component\BoxAnchorRightComponent.xaml.cs">
            <DependentUpon>BoxAnchorRightComponent.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

</Project>
