<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:toolkit="clr-namespace:Syncfusion.Maui.Toolkit;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModel="clr-namespace:NodeSharp.Client.ViewModel"
             x:Class="NodeSharp.Client.Component.NodeToolListComponent">

    <Border Stroke="Gray" StrokeThickness="1" BackgroundColor="LightGray" StrokeShape="RoundRectangle 1">
        <Grid Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Syncfusion themed input -->
            <Grid Grid.Row="0" Grid.ColumnSpan="0" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Text input fills -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Button fixed -->
                </Grid.ColumnDefinitions>

                <core:SfTextInputLayout Grid.Column="0"
                                        Hint="Search by name"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center">

                    <core:SfTextInputLayout.HintLabelStyle>
                        <core:LabelStyle
                            FontSize="16"
                            FontAttributes="Italic"
                            TextColor="Blue" />
                    </core:SfTextInputLayout.HintLabelStyle>

                    <Entry x:Name="SearchBox" />
                    <core:SfTextInputLayout.TrailingView>
                        <Label Text="&#xe713;"
                               FontFamily="MaterialAssets"

                               FontSize="24"
                               TextColor="Black">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </core:SfTextInputLayout.TrailingView>


                </core:SfTextInputLayout>
            </Grid>

            <syncfusion:SfListView
                x:Name="ListViewNodesInfo"
                Grid.Row="1"
                ItemsSource="{Binding Nodes}"
                SelectionMode="Single"
                DragStartMode="OnHold"
                SelectionBackground="LightBlue"
                ItemSize="100">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModel:NodeInformationModel">
                        <Border Margin="4, 3, 4, 3" Stroke="Gray" StrokeThickness="1" BackgroundColor="LightGray"
                                StrokeShape="RoundRectangle 5">
                            <Border.Shadow>
                                <Shadow Radius="10" Opacity="0.5" Brush="Black" Offset="10,10" />
                            </Border.Shadow>

                            <Grid Padding="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.4*" />
                                    <RowDefinition Height="0.6*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Text="{Binding Symbol}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontFamily="MaterialAssets"
                                           FontSize="24"
                                           TextColor="Black">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSearchClicked" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label Grid.Column="1" Text="{Binding TypeId}"
                                           HorizontalOptions="Center"
                                           FontAttributes="None" TextColor="Coral" FontSize="21" />
                                </Grid>

                                <Label Grid.Row="1" Text="{Binding Information}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="4"
                                       HorizontalOptions="Center"
                                       FontAttributes="None" TextColor="Teal" FontSize="11" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" Padding="10"
                  HorizontalOptions="Fill" VerticalOptions="End">

                <!-- Save -->
                <Label Grid.Column="0"
                       Text="&#xf0c7;"
                       TextColor="Black"
                       FontFamily="FontSolid"
                       FontSize="32"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       ToolTipProperties.Text="Save">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Save As -->
                <Label Grid.Column="1"
                       Text="&#xf56f;"
                       FontFamily="FontSolid"
                       FontSize="32"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       ToolTipProperties.Text="Save As">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveAsTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Load -->
                <Label Grid.Column="2"
                       Text="&#xf07c;"
                       FontFamily="FontSolid"
                       FontSize="32"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       ToolTipProperties.Text="Load">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoadTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- New -->
                <Label Grid.Column="3"
                       Text="&#xf15b;"
                       FontFamily="FontSolid"
                       FontSize="32"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       ToolTipProperties.Text="New">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Quit -->
                <Label Grid.Column="4"
                       Text="&#xf2f5;"
                       FontFamily="FontSolid"
                       FontSize="32"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       ToolTipProperties.Text="Quit">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuitTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>


        </Grid>
    </Border>
</ContentView>