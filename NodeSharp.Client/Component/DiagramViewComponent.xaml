<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:NodeSharp.Client.Component"
             xmlns:client="clr-namespace:NodeSharp.Client"
             xmlns:viewModel="clr-namespace:NodeSharp.Client.ViewModel"
             x:Class="NodeSharp.Client.Component.DiagramViewComponent"
             Background="White"
             IsClippedToBounds="True">

    <Grid Background="Transparent" IsClippedToBounds="True">
        <Grid.GestureRecognizers>
            <PinchGestureRecognizer PinchUpdated="OnCanvasPinch" />
            <PanGestureRecognizer PanUpdated="OnCanvasPan" />
            <TapGestureRecognizer Tapped="OnCanvasTapped" />
        </Grid.GestureRecognizers>

        <GraphicsView x:Name="ConnectionCanvas"
                      WidthRequest="3000"
                      HeightRequest="2000"
                      HorizontalOptions="Start"
                      VerticalOptions="Start"
                      InputTransparent="True">
            <GraphicsView.Drawable>
                <component:CurvedLineDrawable />
            </GraphicsView.Drawable>
        </GraphicsView>

        <AbsoluteLayout x:Name="CanvasSurface" AutomationId="CanvasSurface" WidthRequest="3000"
                        HeightRequest="2000"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        IsClippedToBounds="True"
                        BackgroundColor="Transparent"
                        InputTransparent="False"
                        BindableLayout.ItemsSource="{Binding BoxNodes}">
            <AbsoluteLayout.GestureRecognizers>
                <DropGestureRecognizer AllowDrop="True"
                                       DragOver="OnDragOver"
                                       Drop="OnDrop" />
            </AbsoluteLayout.GestureRecognizers>
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <component:DraggableBoxComponent
                        AutomationId="{Binding NodeId, Mode=TwoWay}"
                        X="{Binding X, Mode=TwoWay}"
                        Y="{Binding Y, Mode=TwoWay}"
                        BoxColor="{Binding BoxColor}"
                        x:DataType="viewModel:BoxNode" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AbsoluteLayout>
    </Grid> 
</ContentView>