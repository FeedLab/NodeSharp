<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="clr-namespace:NodeSharp.Client.Component"
             xmlns:client="clr-namespace:NodeSharp.Client"
             xmlns:viewModel="clr-namespace:NodeSharp.Client.ViewModel"
             x:Class="NodeSharp.Client.Component.DiagramViewComponent"
             Background="White"
             IsClippedToBounds="True"
             >

    <Grid Background="Transparent" IsClippedToBounds="True">
        <AbsoluteLayout x:Name="CanvasSurface" WidthRequest="3000"
                        HeightRequest="2000"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        IsClippedToBounds="True"
                        BindableLayout.ItemsSource="{Binding Nodes}" >
            <AbsoluteLayout.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#F0F0F5" Offset="0.3" />
                    <GradientStop Color="#FFFFFF" Offset="0.5" />
                    <GradientStop Color="#E8E8F0" Offset="0.7" />
                    <GradientStop Color="#DCDCE6" Offset="1.0" />
                </LinearGradientBrush>
            </AbsoluteLayout.Background>
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <component:DraggableBoxComponent
                        X="{Binding X, Mode=TwoWay}"
                        Y="{Binding Y, Mode=TwoWay}"
                        BoxColor="{Binding BoxColor}"
                        x:DataType="viewModel:BoxNode" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AbsoluteLayout>
    </Grid>
</ContentView>