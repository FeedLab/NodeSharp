<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:NodeSharp.Client.ViewModel"
             xmlns:component="using:NodeSharp.Client.Component"
             x:Class="NodeSharp.Client.Component.DraggableBoxComponent"
             x:Name="Root">

    <ContentView.Resources>
        <Style x:Key="DraggableBoxStyle" TargetType="Border">
            <!-- <Setter Property="WidthRequest" Value="100" /> -->
            <!-- <Setter Property="HeightRequest" Value="100" /> -->
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="Gray" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid InputTransparent="False">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
        </Grid.GestureRecognizers>
        <Border
            x:Name="MainBorder"
            InputTransparent="False"
            Margin="0"
            Padding="0"
            Style="{StaticResource DraggableBoxStyle}"
            BackgroundColor="{Binding BoxColor, Source={x:Reference Root}}"
            AbsoluteLayout.LayoutFlags="PositionProportional">
            


            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftAnchorArea" BackgroundColor="Transparent" Grid.Column="0" Grid.Row="0" InputTransparent="False">
                  <component:BoxAnchorLeftComponent BindableLayout.ItemsSource="{Binding .}"/>
                </Grid>
                <Grid x:Name="RightAnchorArea" BackgroundColor="Transparent" Grid.Column="2" Grid.Row="0" InputTransparent="False">
                    <component:BoxAnchorRightComponent BindableLayout.ItemsSource="{Binding .}"/>

                </Grid>

                <Grid Margin="4" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <Label Grid.Row="0" Text="{Binding Node.Name}"
                           LineBreakMode="NoWrap"
                           HorizontalOptions="Center"
                           FontAttributes="None" TextColor="DarkRed" FontSize="12" >
                        <!-- <Label.Triggers> -->
                        <!--     <DataTrigger TargetType="Label" Binding="{Binding IsHovered, Source={x:Reference Root}}" Value="True"> -->
                        <!--         <Setter Property="Scale" Value="1.05" /> -->
                        <!--         <Setter Property="Shadow"> -->
                        <!--             <Setter.Value> -->
                        <!--                 <Shadow Brush="Blue" Offset="2,2" Radius="10" Opacity="0.8" /> -->
                        <!--             </Setter.Value> -->
                        <!--         </Setter> -->
                        <!--     </DataTrigger> -->
                        <!-- </Label.Triggers> -->
                    </Label>

                    <Label Grid.Row="1" Text="{Binding Node.TypeId}"
                           LineBreakMode="NoWrap"
                           HorizontalOptions="Center"
                           FontAttributes="None" TextColor="DarkGreen" FontSize="14" />

                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>