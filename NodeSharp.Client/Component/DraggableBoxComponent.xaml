<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:component="using:NodeSharp.Client.Component"
             x:Class="NodeSharp.Client.Component.DraggableBoxComponent"
             x:Name="Root">
    <ContentView.Resources>
        <Style x:Key="DraggableBoxStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Stroke" Value="#30000000" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.25" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid
        x:Name="DraggableBoxParentGrid"
        AutomationId="DraggableBoxParentGrid"
        InputTransparent="False">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
        </Grid.GestureRecognizers>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftAnchorArea" BackgroundColor="Transparent" Grid.Column="0" Grid.Row="0"
              InputTransparent="False" VerticalOptions="Fill" HorizontalOptions="Fill">
            <component:BoxAnchorLeftComponent BindableLayout.ItemsSource="{Binding .}" />
        </Grid>

        <Grid x:Name="RightAnchorArea" BackgroundColor="Transparent" Grid.Column="2" Grid.Row="0"
              InputTransparent="False" VerticalOptions="Fill" HorizontalOptions="Fill">
            <component:BoxAnchorRightComponent BindableLayout.ItemsSource="{Binding .}" />
        </Grid>

        <Border
            x:Name="MainBorder"
            Grid.Column="1" Grid.Row="0"
            InputTransparent="False"
            Margin="0"
            Padding="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Style="{StaticResource DraggableBoxStyle}"
            AbsoluteLayout.LayoutFlags="PositionProportional">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{Binding BoxColorLight, Source={x:Reference Root}}" Offset="0.0" />
                    <GradientStop Color="{Binding BoxColor, Source={x:Reference Root}}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <ContentView
                x:Name="BoxNodeBodyContainer"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- <Grid -->
            <!--     x:Name="MainBorderGrid" -->
            <!--     Margin="6" -->
            <!--     HorizontalOptions="Fill" -->
            <!--     VerticalOptions="Fill"> -->
            <!--     <Grid.RowDefinitions> -->
            <!--         <RowDefinition Height="*" /> -->
            <!--     </Grid.RowDefinitions> -->
            <!-- -->
            <!--     <Grid.ColumnDefinitions> -->
            <!--         <ColumnDefinition Width="Auto" /> -->
            <!--         <ColumnDefinition Width="*" /> -->
            <!--         <ColumnDefinition Width="Auto" /> -->
            <!--     </Grid.ColumnDefinitions> -->
            <!-- -->
            <!--     <ContentView x:Name="BoxNodeBodyContainer" Grid.Column="1" /> -->
            <!-- </Grid> -->
        </Border>

        <ContentView
            x:Name="BoxNodeStatusContainer"
            Grid.Row="1"
            Grid.Column="1"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            Background="Transparent" />
        <!-- <Grid -->
        <!--     x:Name="StatusComponent" -->
        <!-- -->
        <!--     BackgroundColor="Transparent" -->
        <!--     Background="Transparent" -->
        <!--     HorizontalOptions="Fill"> -->
        <!-- </Grid> -->
    </Grid>
</ContentView>