<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NodeSharp.Client.Component.DraggableBoxComponent"
             x:Name="Root">

    <ContentView.Resources>
        <Style x:Key="DraggableBoxStyle" TargetType="Border">
            <!-- <Setter Property="WidthRequest" Value="100" /> -->
            <!-- <Setter Property="HeightRequest" Value="100" /> -->
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="Gray" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Border Style="{StaticResource DraggableBoxStyle}" Padding="4"
            BackgroundColor="{Binding BoxColor, Source={x:Reference Root}}" >

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Label Grid.Row="0" Text="{Binding Node.Name}" 
                   LineBreakMode="NoWrap"
                   HorizontalOptions="Center"                                   
                   FontAttributes="None" TextColor="DarkRed" FontSize="12" />

            <Label Grid.Row="1" Text="{Binding Node.TypeId}" 
                   LineBreakMode="NoWrap"
                   HorizontalOptions="Center"                                   
                   FontAttributes="None" TextColor="DarkGreen" FontSize="14" />

        </Grid>
    </Border>
</ContentView>