<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:NodeSharp.Client.ViewModel"
             xmlns:component="using:NodeSharp.Client.Component"
             xmlns:components="clr-namespace:NodeSharp.Nodes.Common.Components;assembly=NodeSharp.Nodes.Common"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NodeSharp.Client.Component.DraggableBoxComponent"
             x:Name="Root">

    <ContentView.Resources>
        <Style x:Key="DraggableBoxStyle" TargetType="Border">
            <!-- <Setter Property="WidthRequest" Value="100" /> -->
            <!-- <Setter Property="HeightRequest" Value="100" /> -->
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="Gray" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid InputTransparent="False">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
        </Grid.GestureRecognizers>
        <Border
            x:Name="MainBorder"
            InputTransparent="False"
            Margin="0"
            Padding="0"
            Style="{StaticResource DraggableBoxStyle}"
            BackgroundColor="{Binding BoxColor, Source={x:Reference Root}}"
            AbsoluteLayout.LayoutFlags="PositionProportional">


            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftAnchorArea" BackgroundColor="Transparent" Grid.Column="0" Grid.Row="0"
                      InputTransparent="False">
                    <component:BoxAnchorLeftComponent BindableLayout.ItemsSource="{Binding .}" />
                </Grid>
                <Grid x:Name="RightAnchorArea" BackgroundColor="Transparent" Grid.Column="2" Grid.Row="0"
                      InputTransparent="False">
                    <component:BoxAnchorRightComponent BindableLayout.ItemsSource="{Binding .}" />

                </Grid>

                <ContentView x:Name="BoxNodeBodyContainer" Grid.Column="1" />
            </Grid>
        </Border>
    </Grid>
</ContentView>