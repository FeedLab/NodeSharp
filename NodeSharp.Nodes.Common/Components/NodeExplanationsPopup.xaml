<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NodeSharp.Nodes.Common.ViewModels"
             xmlns:smartComponents="clr-namespace:Syncfusion.Maui.SmartComponents;assembly=Syncfusion.Maui.SmartComponents"
             x:Class="NodeSharp.Nodes.Common.Components.NodeExplanationsPopup"
             x:DataType="viewModels:NodeExplanationsPopupViewModel"
             x:Name="Root"
             BackgroundColor="#F8F9FA"
             Padding="1"
             MaximumWidthRequest="950"
             MinimumWidthRequest="650"
             MinimumHeightRequest="550"
             MaximumHeightRequest="750">

    <ContentView.Resources>
        <Style TargetType="Button">
            <Setter Property="Scale" Value="1"/>
            <Setter Property="TranslationY" Value="0"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1"/>
                                <Setter Property="TranslationY" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.06"/>
                                <Setter Property="TranslationY" Value="-2"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.98"/>
                                <Setter Property="TranslationY" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.6"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="15">
    <!-- Label -->
    <Entry Grid.Row="0"
           Text="{Binding CurrentLabel, Mode=TwoWay}"
           FontSize="24"
           FontAttributes="Bold"
           TextColor="#2C3E50"
           BackgroundColor="Transparent"
           ClearButtonVisibility="WhileEditing"
           IsVisible="{Binding Source={x:Reference Root}, Path=UseEditableFields}"/>

    <Label Grid.Row="0"
           Text="{Binding CurrentLabel}"
           FontSize="24"
           FontAttributes="Bold"
           TextColor="#2C3E50"
           IsVisible="{Binding Source={x:Reference Root}, Path=UseReadOnlyFields}"/>

    <!-- Description -->
    <Editor Grid.Row="1"
            Text="{Binding CurrentDescription, Mode=TwoWay}"
            FontSize="15"
            TextColor="#546E7A"
            AutoSize="TextChanges"
            BackgroundColor="Transparent"
            IsVisible="{Binding Source={x:Reference Root}, Path=UseEditableFields}"/>

    <Label Grid.Row="1"
           Text="{Binding CurrentDescription}"
           FontSize="15"
           TextColor="#546E7A"
           LineBreakMode="WordWrap"
           IsVisible="{Binding Source={x:Reference Root}, Path=UseReadOnlyFields}"/>

        <!-- Code -->
        <Grid Grid.Row="2" VerticalOptions="FillAndExpand">
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="20" Opacity="0.15"/>
                </Border.Shadow>

                <smartComponents:SfSmartTextEditor x:Name="CodeEditor"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill"
                                                   Text="{Binding CurrentCode, Mode=TwoWay}"
                                                   BackgroundColor="Transparent"
                                                   Margin="0">
                    <smartComponents:SfSmartTextEditor.TextStyle>
                        <smartComponents:SmartTextEditorStyle
                            FontSize="13"
                            FontFamily="Courier New"
                            TextColor="#37474F" />
                    </smartComponents:SfSmartTextEditor.TextStyle>
                </smartComponents:SfSmartTextEditor>
            </Border>

            <!-- Copy Button (Frozen at top-right) -->
            <Button x:Name="CopyButton"
                    Text="📋"
                    Command="{Binding CopyCodeCommand}"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    CornerRadius="10"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="12">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.25"/>
                </Button.Shadow>
            </Button>
        </Grid>
        <!-- Bottom: Navigation Controls -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto" ColumnSpacing="10">
            <!-- Add Button -->
            <Button Grid.Column="0"
                    Text="+"
                    Command="{Binding AddExplanationCommand}"
                    WidthRequest="52"
                    HeightRequest="44"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    IsVisible="{Binding Source={x:Reference Root}, Path=UseEditableFields}">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- Insert Button -->
            <Button Grid.Column="1"
                    Text="Insert"
                    Command="{Binding InsertExplanationCommand}"
                    WidthRequest="76"
                    HeightRequest="44"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="10"
                    IsVisible="{Binding Source={x:Reference Root}, Path=UseEditableFields}">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- Delete Button -->
            <Button Grid.Column="2"
                    Text="-"
                    Command="{Binding DeleteExplanationCommand}"
                    IsEnabled="{Binding HasExplanations}"
                    WidthRequest="52"
                    HeightRequest="44"
                    BackgroundColor="#EF5350"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    IsVisible="{Binding Source={x:Reference Root}, Path=UseEditableFields}">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- Spacer -->
            <BoxView Grid.Column="3" Color="Transparent"/>

            <!-- Previous Button -->
            <Button Grid.Column="4"
                    Text="Previous"
                    Command="{Binding PreviousCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    WidthRequest="52"
                    HeightRequest="44"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"
                    Margin="0,0,10,0">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- Next Button -->
            <Button Grid.Column="5"
                    Text="Next"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    WidthRequest="52"
                    HeightRequest="44"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"
                    Margin="0,0,10,0">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- Close Button -->
            <Button Grid.Column="6"
                    Text="Close"
                    Command="{Binding CloseCommand}"
                    WidthRequest="52"
                    HeightRequest="44"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>
        </Grid>

    </Grid>
</ContentView>

