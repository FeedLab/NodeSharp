<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:NodeSharp.Nodes.Common.ViewModels"
             x:Class="NodeSharp.Nodes.Common.Components.BoxNodeStatusTextComponent"
             x:DataType="viewModels:BoxNodeStatusTextViewModel"
             BackgroundColor="Transparent"
             Background="Transparent"
             WidthRequest="{Binding Node.BoxBodyDimension.Width}" >
    
    <Label
        Margin="0,2,0,0"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        TextColor="DodgerBlue"
        BackgroundColor="Transparent"
        Background="Transparent"
        FontSize="10"
        Text="{Binding Node.BoxNodeStatus.Message}" />
</ContentView>